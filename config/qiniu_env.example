# 七牛云配置
# 请到七牛云控制台 -> 密钥管理 获取以下信息
export QINIU_ACCESS_KEY="your_access_key_here"
export QINIU_SECRET_KEY="your_secret_key_here"

# 企业微信机器人 Webhook（可选）
# 用于证书续期后发送通知
# 在企业微信群中添加机器人，获取 Webhook URL
export WECOM_WEBHOOK="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here"

# 需要上传到七牛云的域名列表（空格分隔）
# 只有这些域名的证书会自动上传到七牛云 CDN
export QINIU_DOMAINS="file.example.com"

# 使用方法：
# 1. 复制此文件为 qiniu_env.sh
# 2. 填入真实的密钥信息  
# 3. 执行：source qiniu_env.sh 来加载环境变量
# 4. 或者添加到 /etc/environment 或 ~/.bashrc 中
